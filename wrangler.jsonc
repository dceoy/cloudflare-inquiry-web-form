// Cloudflare Workers configuration for the inquiry web form.
//
// Secret values are configured separately on the Worker and are never stored in Git.
{
  "name": "cloudflare-inquiry-web-form",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "inquiry.dceoy.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "secrets": {
    "required": [
      "RESEND_API_KEY",
      "TURNSTILE_SECRET_KEY",
      "EMAIL_FROM",
      "EMAIL_TO"
    ]
  },
  "vars": {
    "TURNSTILE_HOSTNAMES": "inquiry.dceoy.com",
    "TURNSTILE_ACTION": "contact"
  },
  "previews": {
    "vars": {
      "TURNSTILE_HOSTNAMES": "",
      "TURNSTILE_ACTION": "contact"
    }
  },
  "env": {
    "local": {
      "assets": {
        "directory": "./public",
        "run_worker_first": ["/api/*"]
      },
      "secrets": {
        "required": [
          "RESEND_API_KEY",
          "TURNSTILE_SECRET_KEY",
          "EMAIL_FROM",
          "EMAIL_TO"
        ]
      },
      "vars": {
        "TURNSTILE_HOSTNAMES": "localhost,127.0.0.1,dummy-key.example.com",
        "TURNSTILE_ACTION": "test"
      }
    }
  }
}

// Cloudflare Workers configuration for the inquiry web form.
//
// EMAIL_FROM, EMAIL_TO, and the send_email binding addresses below are
// placeholders (RFC 2606 "example.com"). Replace them with your verified
// sender and destination before deploying — see README.md.
{
  "name": "cloudflare-inquiry-web-form",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "EMAIL_FROM": "inquiries@example.com",
    "EMAIL_TO": "team@example.com"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "team@example.com",
      "allowed_sender_addresses": ["inquiries@example.com"]
    }
  ]
}

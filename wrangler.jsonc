// Cloudflare Workers configuration for the inquiry web form.
//
// EMAIL_FROM and EMAIL_TO are configured separately as Worker secrets.
{
  "name": "cloudflare-inquiry-web-form",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "inquiry.dceoy.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  }
}

// Cloudflare Workers configuration for the inquiry web form.
//
// EMAIL_FROM is public configuration for the verified Resend sending domain.
// EMAIL_TO is configured separately as a production Worker secret.
{
  "name": "cloudflare-inquiry-web-form",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "inquiry.dceoy.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "EMAIL_FROM": "inquiry@dceoy.com"
  },
  "previews": {
    "vars": {
      "EMAIL_FROM": "inquiry@preview.invalid",
      "EMAIL_TO": "preview@invalid.example"
    }
  }
}

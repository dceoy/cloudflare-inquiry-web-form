{
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "files": {
    "includes": ["**", "!**/*.md", "!**/*.mdx", "!!**/*.yaml", "!!**/*.yml"]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "complexity": {
        "useLiteralKeys": "off"
      },
      "style": {
        "noExcessiveLinesPerFile": "off",
        "useExportsLast": "off",
        "noDefaultExport": "off"
      },
      "correctness": {
        "useQwikValidLexicalScope": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**/*.test.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          },
          "style": {
            "useConsistentTestIt": "off",
            "useNamingConvention": "off"
          },
          "suspicious": {
            "useAwait": "off"
          },
          "performance": {
            "useTopLevelRegex": "off"
          }
        }
      }
    },
    {
      "includes": ["src/index.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "useMaxParams": "off"
          },
          "suspicious": {
            "noUnnecessaryConditions": "off"
          }
        }
      }
    },
    {
      "includes": ["public/**/*.css"],
      "linter": {
        "rules": {
          "suspicious": {
            "useBaseline": "off"
          }
        }
      }
    }
  ]
}

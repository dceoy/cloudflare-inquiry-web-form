{
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "files": {
    "includes": [
      "**",
      "!**/*.md",
      "!**/*.mdx",
      "!!**/*.yaml",
      "!!**/*.yml"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "all",
      "complexity": {
        "useLiteralKeys": "off"
      },
      "style": {
        "noExcessiveLinesPerFile": "off",
        "useExportsLast": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/**/*.test.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          },
          "style": {
            "useConsistentTestIt": "off",
            "useNamingConvention": "off"
          }
        }
      }
    }
  ]
}

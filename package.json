{
  "name": "cloudflare-inquiry-web-form",
  "version": "0.0.0",
  "private": true,
  "description": "Minimal Cloudflare-native inquiry form",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "audit": "pnpm audit",
    "audit:fix": "pnpm audit --fix=override",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "biome format --write . && oxfmt --write '**/*.{md,mdx}' --no-error-on-unmatched-pattern",
    "format:check": "biome format . && oxfmt --check '**/*.{md,mdx}' --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "dev": "wrangler dev --env local",
    "deploy": "wrangler deploy",
    "all": "pnpm run format && pnpm run lint:fix && pnpm run typecheck && pnpm run audit:fix && pnpm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dceoy/cloudflare-inquiry-web-form.git"
  },
  "keywords": [
    "cloudflare-workers",
    "wrangler",
    "inquiry-form",
    "turnstile"
  ],
  "license": "AGPL-3.0",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.150.0"
  }
}
